<quiqqer>
    <package>
        <title>
            <locale group="quiqqer/authgoogle" var="package.title"/>
        </title>

        <description>
            <locale group="quiqqer/authgoogle" var="package.description"/>
        </description>

        <capabilities schemaVersion="1">
            <capability id="authentication.google-sign-in">
                <title>Google sign-in</title>
                <description>
                    Authenticates QUIQQER users with Google accounts and manages the link between the Google identity and the local user account.
                </description>
            </capability>

            <capability id="identity.google-registration">
                <title>Google registration</title>
                <description>
                    Registers QUIQQER frontend users from validated Google identity tokens and supports automatic or manual account activation.
                </description>
            </capability>
        </capabilities>

        <image src="URL_OPT_DIR/quiqqer/authgoogle/bin/images/Logo.jpg"/>

        <preview>
            <image src="URL_OPT_DIR/quiqqer/authgoogle/bin/images/preview/Frontend_Registration.png"/>
            <image src="URL_OPT_DIR/quiqqer/authgoogle/bin/images/preview/Backend_Settings.png"/>
        </preview>

        <support>
            <email><![CDATA[support@pcsg.de]]></email>
            <forum><![CDATA[https://community.quiqqer.com]]></forum>
            <source><![CDATA[https://dev.quiqqer.com/quiqqer/authgoogle]]></source>
            <issues><![CDATA[https://dev.quiqqer.com/quiqqer/authgoogle/issues]]></issues>
            <wiki><![CDATA[https://dev.quiqqer.com/quiqqer/authgoogle/wikis/home]]></wiki>
        </support>

        <copyright>
            <name><![CDATA[PCSG - Computer & Internet Service OHG]]></name>
            <license><![CDATA[GPL-3.0-or-later]]></license>
        </copyright>

        <provider>
            <auth src="\QUI\Auth\Google\Auth"/>
            <registrar src="\QUI\Registration\Google\Registrar"/>
        </provider>

    </package>
</quiqqer>
